# Rode configuration. Copy to .env and edit. Every variable has a sensible
# default; you only need to set the ones marked REQUIRED for your setup.
#
# Secrets belong here (or in your orchestrator's secret store), never in the
# image. This file is documentation; .env is git-ignored.

# ---------------------------------------------------------------- image
# Image and tag used by docker-compose.yml.
RODE_IMAGE=ghcr.io/clucraft/rode
RODE_TAG=latest

# ---------------------------------------------------------------- server
# Port published on the host. Inside the container the server always listens
# on 8080.
RODE_PORT=8080
# trace | debug | info | warn | error | fatal
RODE_LOG_LEVEL=info
# Where the SQLite database, config snapshot and recordings live. In Docker
# this is the rode-data named volume.
RODE_DATA_DIR=/data

# ---------------------------------------------------------------- data source
# REQUIRED. Which adapter to use: nmea0183-tcp | nmea0183-udp | signalk-ws | simulator | replay
RODE_SOURCE=nmea0183-tcp
# For nmea0183-tcp / nmea0183-udp: the Cortex hub's address on the boat LAN.
# Find it in the Cortex Onboard app. Vesper transponders have historically
# served NMEA 0183 on port 39150 — verify on your unit.
RODE_NMEA_HOST=192.168.1.100
RODE_NMEA_PORT=39150
# For signalk-ws: the Signal K server's WebSocket URL.
# RODE_SIGNALK_URL=ws://signalk.local:3000/signalk/v1/stream
# For simulator: which checked-in scenario to play, and the time speed-up.
# RODE_SIM_SCENARIO=quiet-night
# RODE_SIM_SPEED=1
# For replay: path to a recorded .nmea file (inside RODE_DATA_DIR/recordings).
# RODE_REPLAY_FILE=recordings/2026-09-01-anchored.nmea

# ---------------------------------------------------------------- charts
# URL of a TileServer-GL style.json (the optional `tiles` profile). Leave unset
# to use the schematic polar view only.
# RODE_TILES_URL=http://localhost:8081/styles/basic/style.json
# Host port for the tiles container.
RODE_TILES_PORT=8081
RODE_TILES_PUBLIC_URL=http://localhost:8081

# ---------------------------------------------------------------- mqtt (optional profile)
RODE_MQTT_PORT=1883
# Where the server publishes alarm state (used by the `mqtt` profile or your
# own broker). Leave unset to disable MQTT output.
# RODE_MQTT_URL=mqtt://mosquitto:1883
# RODE_MQTT_TOPIC_PREFIX=rode

# ---------------------------------------------------------------- notifications (phase 7)
# ntfy — self-hostable push. Topic URL, e.g. https://ntfy.sh/your-secret-topic
# RODE_NTFY_URL=
# RODE_NTFY_TOKEN=
# Pushover
# RODE_PUSHOVER_USER=
# RODE_PUSHOVER_TOKEN=
# Telegram
# RODE_TELEGRAM_BOT_TOKEN=
# RODE_TELEGRAM_CHAT_ID=
# SMTP — used only for the daily heartbeat email.
# RODE_SMTP_HOST=
# RODE_SMTP_PORT=587
# RODE_SMTP_USER=
# RODE_SMTP_PASS=
# RODE_SMTP_FROM=rode@yourboat.example

# ---------------------------------------------------------------- security (phase 5)
# Set to true when served over TLS (Caddy profile or Tailscale certs) so the
# session cookie gets the Secure flag and HSTS is sent.
# RODE_TLS=false
